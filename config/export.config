params {
  export {
    search {
      run = true
      max_forks = 6
      max_entries = 2237839
      schema = 'http://www.ebi.ac.uk/ebisearch/XML4dbDumps.xsd'
      publish {
        host = ""
        path = "${launchDir}/text-search"
      }
      memory = 16.GB
    }

    sequence_search {
      run = true
      max_file_size = '150MB'
      max_forks = 10

      publish {
        host = ""
        path = "${launchDir}/sequence-search"
      }

      create_fasta {
        memory_table {
          ena = 25.GB
          all_except_rrna = 20.GB
          silva = 20.GB
          rfam = 4.GB
          __default = 2.GB
        }
      }
    }

    sankey {
      run = true
      publish = "${launchDir}/sankey"
    }

    ftp {
      run = true
      publish = "${launchDir}/ftp"

      ensembl {
        chunk_size = 100000
        maxForks = 4
      }

      coordinates {
        maxForks = 30
      }

      rfam {
        go_annotations {
          memory = 8.GB
        }
      }

      sequences {
        by_database {
          max_forks = 4
        }
        by_species {
          max_forks = 4
        }
      }

      gpi {
        memory = 8.GB
      }
    }

    huggingface {
      run = true
      // Path to the per-database version breakdown text file for the README.
      update_specs = ""
    }
  }
}
