params {
  repeatmasker {
    run = true
    load = true
    query = "files/repeatmasker/query.sql"
    container = "rnacentral/repeatmasker:4.1.7"
    // Host directory holding the Dfam FamDB (*.h5); populated by prepare-environment.
    dfam_path = "$launchDir/repeatmasker-dfam"
    // Curated Dfam FamDB partition 0 (root + curated families) for the hmmer engine.
    dfam_url = "https://www.dfam.org/releases/Dfam_3.8/families/FamDB/dfam38_full.0.h5.gz"
    // Dedicated bind: mount the host Dfam FamDB over the image's Libraries/famdb
    // rather than reusing common_container, so the bind does not shadow the
    // tool's own /rna data (cf. the r2dt bind gotcha).
    container_options = "--contain --bind $launchDir --bind $launchDir/repeatmasker-dfam:/rna/RepeatMasker/Libraries/famdb"
    cpus = 4
    chunk_size = 1000
    min_len = 200
    db_chunk_size = 100000
    max_forks = 3500
  }
}

process {
  withName: 'repeatmasker_scan' {
    cpus = params.repeatmasker.cpus
    maxForks = params.repeatmasker.max_forks
  }
}
