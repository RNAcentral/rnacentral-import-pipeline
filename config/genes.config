params {
  genes {
    run = true

    so_model_url = 'https://huggingface.co/RNAcentral/SO_Node2Vec/resolve/main/so_embedding_model.parquet'
    taxa_query = 'files/genes/taxa.sql'

    // Settings for genes.nf:infer_genes. The values match the replay that built the
    // gene history (rnacentral-genes-history/main_replay.nf), so live releases stay
    // consistent with it.
    gnn {
      // cuda12 build, published by the inference repo's CI. Pin a digest for a release.
      image = 'ghcr.io/rnacentral/rnacentral-gene-gnn-inference:latest'
      checkpoint = '/opt/checkpoint/model'   // baked into the image
      threshold = 0.5                        // edge operating point; see docs/gene-prediction-handoff.md
      dtype = 'float32'                      // reproduces training numerics
      gpu_type = 'a100'                      // must match the cluster's GRES name (sinfo -o "%P %G")
      gpu_jobs = 8                           // every taxon's files are split across this many GPU jobs
      cpus = 16
      memory_gb = 128                        // per attempt; human (~3M transcripts) is the big case
      hours = 24                             // per attempt, for a whole batch
    }
  }
}
