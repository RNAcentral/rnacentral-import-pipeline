params {
  r2dt {
    run = true
    sequence_chunks = 4000
    data_chunk_size = 1024 * 1000 * 1000
    sequence_chunk_size = 100
    sequence_count = 1000000
    tablename = 'traveler_sequences_to_analyze'
    publish = "$baseDir/r2dt"

    // Layout results per publish/parse job; those stages are too cheap to be worth a job each.
    batch_size = 20

    // layout_max_forks * layout.memory is the peak RAM asked of the cluster, so raise against that.
    layout_max_forks = 500
    // publish runs on the small datamover queue, so batch_size is the lever here, not concurrency.
    publish_max_forks = 100
    parse_max_forks = 1000
    container = 'rnacentral/r2dt:develop'
    cms_path = "$baseDir/singularity/bind/r2dt/data/cms"

    find_possible {
      memory = '4GB'
      max_len = 10000
    }

    layout {
      memory = '8GB'
    }

    store {
      memory = '4GB'
    }

    s3 {
      env = 'prod'
    }
  }
}
