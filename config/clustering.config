params {
  clustering {
    // Loading is opt-in: the clustering is produced outside this pipeline, and `dir` is its
    // <outdir>/parquet (clusters.parquet plus fragments.parquet and/or variants.parquet).
    load = false
    dir = null

    // Publish the deduplicated set (FTP FASTA, HuggingFace split). Needs rnc_sequence_cluster
    // to be loaded; the search export's is_fragment / in_deduplicated_set fields need only the table.
    export = false
  }
}
