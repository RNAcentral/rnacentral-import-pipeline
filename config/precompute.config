params {
  precompute {
    run = true
    max_entries = 25000
    load_size = 1024 * 1000 * 1000
    maxForks = 20
    method = 'release'
    range.memory = 12.GB
    // The largest ranges run past the cluster's 1d default. Four attempts
    // (36h to 144h) stay under the 7d standard-partition limit.
    range.time = 36.h
  }
}
