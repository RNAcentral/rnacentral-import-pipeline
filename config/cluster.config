// --contain without --workdir gives the container an in-memory /tmp of a few tens
// of MB, so anything buffering a real file there dies with ENOSPC. work/tmp must
// exist before launch - singularity fails hard on a missing workdir and nextflow
// only creates work/ itself.
params {
  // autoMounts (default true) already binds $launchDir at its real path, so a
  // second explicit --bind $launchDir just triggers "destination already in the
  // mount point list"
  common_container = "--contain --workdir $launchDir/work/tmp --bind $launchDir:/rna/rnacentral-import-pipeline"
  // The r2dt image is also rooted at /rna (data lives in /rna/r2dt/data), so we
  // must NOT bind the checkout into /rna/rnacentral-import-pipeline here - doing
  // so shadows the image's own data directories. Bind the launch dir only.
  r2dt_container = "--contain --workdir $launchDir/work/tmp --bind $launchDir"
}

process {
  executor = 'slurm'
  maxForks = 3500
  time = '1d'
  memory = '1 GB'
  containerOptions = params.common_container
}

executor {
  queueSize = 10000
  // '1sec' was ONE submission per second pipeline-wide, throttling every large stage.
  submitRateLimit = '10/1sec'
}

// vim: ft=groovy
