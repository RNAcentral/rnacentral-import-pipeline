params {
  common_container = "--contain --bind $launchDir --bind $launchDir:/rna/rnacentral-import-pipeline"
}

process {
  executor = 'slurm'
  maxForks = 3500
  time = '1d'
  memory = '1 GB'
  containerOptions = params.common_container
}

executor {
  queueSize = 10000
  submitRateLimit = '1sec'
}

// vim: ft=groovy
