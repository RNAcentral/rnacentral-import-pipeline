params {
  databases {

    biogrid {
      inputs {
        remote = 'https://downloads.thebiogrid.org/Download/BioGRID/Latest-Release/BIOGRID-ALL-LATEST.psi25.zip'
        produces = 'BIOGRID-ALL-LATEST.psi25.zip'
      }
    }

    "5srrnadb" {
      remote = '/nfs/leia/production/xfam/users/bsweeney/provided-data/5srnadb/5srnadb-v1.json'
    }

    circatlas {
      run = false
      process.directives.memory = 16.GB
      remote = '/nfs/production/agb/rnacentral/provided-data/circatlas/circatlas.json'
    }

    circpedia {
      run = false
      annotation_base_url = "https://bits.fudan.edu.cn/circpediav3/static/download_cache/annotation/"
      fasta_base_url = "https://bits.fudan.edu.cn/circpediav3/static/download_cache/sequence/"
      species = [
        [annotation: "Caenorhabditis-elegans",   fasta: "Caenorhabditis_elegans_circ",  assembly: "WBcel235"],
        [annotation: "Canis-lupus-familiaris",   fasta: "Canis_lupus_familiaris_circ",  assembly: "ROS_Cfam_1.0"],
        [annotation: "Cavia-porcellus",          fasta: "Cavia_porcellus_circ",         assembly: "Cavpor3.0"],
        [annotation: "Cercocebus-atys",          fasta: "Cercocebus_atys_circ",         assembly: "Caty_1.0"],
        [annotation: "Callithrix-jacchus",       fasta: "Callithrix_jacchus_circ",      assembly: "mCalJac1.pat.X"],
        [annotation: "Drosophila-melanogaster",  fasta: "Drosophila_melanogaster_circ", assembly: "BDGP6"],
        [annotation: "Felis-catus",              fasta: "Felis_catus_circ",             assembly: "Felis_catus_9.0"],
        [annotation: "Gallus-gallus",            fasta: "Gallus_gallus_circ",           assembly: "GRCg7b"],
        [annotation: "Homo-sapiens",             fasta: "Homo_sapiens_circ",            assembly: "GRCh38"],
        [annotation: "Macaca-fascicularis",      fasta: "Macaca_fascicularis_circ",     assembly: "Macaca_fascicularis_6.0"],
        [annotation: "Macaca-mulatta",           fasta: "Macaca_mulatta_circ",          assembly: "Mmul_10"],
        [annotation: "Macaca-nemestrina",        fasta: "Macaca_nemestrina_circ",       assembly: "Mnem_1.0"],
        [annotation: "Mus-musculus",             fasta: "Mus_musculus_circ",            assembly: "GRCm38"],
        [annotation: "Oryctolagus-cuniculus",    fasta: "Oryctolagus_cuniculus_circ",   assembly: "OryCun2.0"],
        [annotation: "Ovis-aries",              fasta: "Ovis_aries_circ",              assembly: "Oar_v3.1"],
        [annotation: "Papio-anubis",             fasta: "Papio_anubis_circ",            assembly: "Panubis1.0"],
        [annotation: "Pongo-abelii",             fasta: "Pongo_abelii_circ",            assembly: "Susie_PABv2"],
        [annotation: "Pan-troglodytes",          fasta: "Pan_troglodytes_circ",         assembly: "pan_Tro_3.0"],
        [annotation: "Rattus-norvegicus",        fasta: "Rattus_norvegicus_circ",       assembly: "mRatBN7.2"],
        [annotation: "Sus-scrofa",              fasta: "Sus_scrofa_circ",              assembly: "Sscrofa11.1"],
      ]
  }

    crw {
      r2dt_repo = "https://github.com/RNAcentral/R2DT.git"
    }

    ena {
      remote = '/nfs/ftp/public/databases/ena/non-coding/snapshot_latest'
      max_sequences = 50000
      // wgs/, tls/ and tsa/ each have thousands of project subdirs; rsync them
      // in batches of this many per task so the fetch fans out across the
      // cluster instead of one giant serial NFS walk.
      subdir_batch_size = 100
    }

    ensembl {
      run = false

      gencode {
        ftp_host = 'ftp.ebi.ac.uk'
      }

      // Unified Ensembl organisms species JSON (all former divisions + bacteria).
      species_json_url = 'https://ftp.ebi.ac.uk/pub/ensemblorganisms/species.json'

      // The same tree on /nfs, readable only from the datamover queue. Files are copied from here.
      ftp_url = 'https://ftp.ebi.ac.uk/pub/ensemblorganisms'
      nfs_path = '/nfs/ftp/public/ensemblorganisms'

      // Lower-case species names to import; empty imports every species.
      species = []

      // Species skipped by the Ensembl import. The first four have dedicated
      // RNAcentral imports (WormBase, FlyBase, SGD, PomBase); the rest preserve
      // historical per-division exclusions. Matched case-insensitively against
      // the species name.
      exclude = [
        /caenorhabditis_elegans.*/,
        /drosophila_melanogaster.*/,
        /saccharomyces_cerevisiae.*/,
        /schizosaccharomyces_pombe.*/,
        /mus_musculus_.*/,
        /cebus_capucinus/,
        /cyprinus_carpio_.*/,
        /cyanidioschyzon_merolae.*/,
        // A 2022 build on idAnoGambNW_F1_1, beside PEST (AgamP4, the assembly we use);
        // PEST's EMBL says taxid 7165 too, so both would load. Revisit if PEST goes.
        /^anopheles_gambiae$/,
      ]

      // MySQL/compara-backed metadata is deferred under the new FTP structure;
      // opt in explicitly once it is re-sourced from the species JSON.
      metadata {
        run = false
      }

      compara {
        // The homology load is the only part that needs ensembl_compara files; set this
        // alone (ensembl.run = false) to load it after the Ensembl xrefs are in.
        run = false
        // The pub/current_* shortcuts are being removed; emf now only lives
        // under pub/current, which still points at the latest release.
        remote = 'ftp://ftp.ensembl.org/pub/current/emf/ensembl-compara/homologies/*.nt.fasta.gz'
      }
    }

    // Protein coding mRNAs and their UTRs, as a database separate from the
    // ncRNA import. Reads the same species.json as ensembl above.
    ensembl_coding {
      run = false
      // Budding yeast UTRs come from SGD and E. coli's from RegulonDB.
      species = [
        'homo_sapiens',
        'mus_musculus',
        'danio_rerio',
        'arabidopsis_thaliana',
        'oryza_sativa_japonica_group',
        'triticum_turgidum_subsp_durum',
        'plasmodium_falciparum_3d7',
        'bacillus_subtilis_subsp_subtilis_str_168',
        'listeria_monocytogenes_egd_e',
        'methanosarcina_acetivorans_c2a',
        'zea_mays',
        'rattus_norvegicus',
        'xenopus_tropicalis',
        'gallus_gallus',
        'macaca_mulatta',
        'drosophila_melanogaster',
        'caenorhabditis_elegans',
        'schizosaccharomyces_pombe_972h',
      ]
    }

    expressionatlas {
      cache = '/hps/nobackup/agb/rnacentral/expression_atlas_cache'
    }

    flybase {
      remote = 'https://s3ftp.flybase.org/releases/current/precomputed_files/genes/ncRNA*.json.gz'
    }

    // GeneCards, MalaCards and miRBase land as dated or versioned files. Keep
    // those drops as the archive and repoint the symlink instead of committing
    // a new path, by running the code below in that `provided-data` directory:
    //   ln -sfn 20260817_UrsIdToGeneCardsSymbol.txt UrsIdToGeneCardsSymbol.txt
    genecards {
      remote = '/nfs/production/agb/rnacentral/provided-data/genecards/UrsIdToGeneCardsSymbol.txt'
      column = 'URSid'
    }

    gtrnadb {
      needs_taxonomy = true
      remote = '/nfs/production/agb/rnacentral/provided-data/gtrnadb'
    }

    hgnc {
      remote = 'https://storage.googleapis.com/public-download-files/hgnc/json/json/locus_groups/non-coding_RNA.json'
    }

    intact {
      remote = 'ftp://ftp.ebi.ac.uk/pub/databases/intact/current/psimitab/intact.zip'
    }

    japonicusdb {
      remote = 'https://www.japonicusdb.org/data/releases/latest/misc/rnacentral.json'
    }

    lncbase {
      remote = '/nfs/production/agb/rnacentral/provided-data/lncbase/LncBase2.json'
    }

    lncbook {
      process.directives.memory = 5.GB
      remote = "/nfs/production/agb/rnacentral/provided-data/lncbook/LncBookv2.0_GRCh38_RNAcentral.json"
    }

    lncipedia {
      run = false
      process.directives.memory = 5.GB
      remote = "https://lncipedia.org/downloads/lncipedia_5_3/lncipedia_5_3_rnacentral.json"
    }

    // Symlinked to the latest dated drop, as for genecards above.
    malacards {
      remote = '/nfs/production/agb/rnacentral/provided-data/malacards/UrsIdToMalaCardsDisease.txt'
      column = 'URSid'
    }

    mgi {
      remote = 'https://www.informatics.jax.org/downloads/reports/MRK_Sequence.rpt'
    }

    // Symlinked to the current release, as for genecards above.
    mirbase {
      process.directives.memory = 4.GB
      remote = "/nfs/production/agb/rnacentral/provided-data/mirbase/mirbase-rnacentral.json"
    }

    mirgenedb {
      remote = '/nfs/production/agb/rnacentral/provided-data/mirgenedb/mirgenedb-v3.json'
    }

    mirtrondb {
      remote = '/nfs/production/agb/rnacentral/provided-data/mirtrondb/all_organisms_both.tsv'
    }

    modomics {
      remote = '/nfs/production/agb/rnacentral/provided-data/modomics/modomics-2025-09-16.json'
    }

    noncode {
      remote = 'http://www.noncode.org/datadownload'
      // [species key, lncAndGene BED]. The key is both the filename suffix and
      // what `rnac noncode parse` resolves the taxid from; v6 only publishes
      // coordinates for human and mouse.
      species = [
        ['human', 'NONCODEv6_hg38.lncAndGene.bed.gz'],
        ['mouse', 'NONCODEv6_mm10.lncAndGene.bed.gz'],
        ['cow', null],
        ['rat', null],
        ['chicken', null],
        ['celegans', null],
        ['fruitfly', null],
        ['zebrafish', null],
        ['yeast', null],
        ['chimp', null],
        ['gorilla', null],
        ['orangutan', null],
        ['rhesus', null],
        ['opossum', null],
        ['platypus', null],
        ['pig', null],
        ['ATH', null],
        ['BNA', null],
        ['BRA', null],
        ['CQU', null],
        ['CRE', null],
        ['CSA', null],
        ['GMA', null],
        ['GRA', null],
        ['MAL', null],
        ['MES', null],
        ['MTR', null],
        ['MAC', null],
        ['ORU', null],
        ['OSA', null],
        ['PPA', null],
        ['POP', null],
        ['SLY', null],
        ['STU', null],
        ['TCA', null],
        ['TPR', null],
        ['TAE', null],
        ['VVI', null],
        ['ZMA', null],
      ]
    }

    pdb {
      run = false
    }

    pirbase {
      // A mirror of v3.0: piRBase's server drops any plain GET of its four
      // largest files. Rebuild with scripts/fetch-pirbase.sh, which takes its
      // list from the species table in databases/pirbase/data.py, so what is
      // downloaded and what is parsed cannot drift apart.
      remote = '/nfs/production/agb/rnacentral/provided-data/pirbase/v3.0'
    }

    pombase {
      remote = 'https://www.pombase.org/data/releases/latest/misc/rnacentral.json'
    }

    psicquic {
      // EBI-hosted services with RNAcentral hits; imex is omitted as it
      // is the union of these and would duplicate every row
      services = ['intact', 'mint', 'uniprot', 'bhf-ucl']
    }

    silva {
      needs_taxonomy = true
      // 144 ships SSU only, so LSU is pinned to the last release that had it.
      // Both are pinned rather than tracking current/; recheck on next release
      // remote = 'http://ftp.arb-silva.de/current/Exports/rnac/'
      remote = [
        'http://ftp.arb-silva.de/release_144/Exports/rnac/SILVA_144_SSUParc.rnac.gz',
        'http://ftp.arb-silva.de/release_138.2/Exports/rnac/SILVA_138.2_LSUParc.rnac.gz',
      ]
    }

    snodb {
      remote = '/nfs/production/agb/rnacentral/provided-data/snodb/snodb-v2.json'
    }

    snorna_database {
      remote = '/nfs/leia/production/xfam/users/bsweeney/provided-data/snorna_database/snornadb-2019-11-11.json'
    }

    quickgo {
      release = false
      memory = 8.GB
      remote = '/nfs/ftp/public/contrib/goa/goa_rna_all.gpa.gz'
    }

    rediportal {
      inputs = [
        [
          assembly_id: 'GRCh38',
          genome_build: 'hg38',
          remote: 'https://rediportal.cloud.ba.infn.it/download/TABLE1_hg38_v3.txt.gz',
        ],
        [
          assembly_id: 'GRCm38',
          genome_build: 'mm10',
          remote: 'https://rediportal.cloud.ba.infn.it/download/TABLE1_mm10_v3.txt.gz',
        ],
      ]
      chunk_size = 1024 * 1000 * 1000
    }

    refseq {
      remote = 'https://ftp.ncbi.nlm.nih.gov/refseq/release/complete/'
    }

    // E. coli transcription units (mRNAs with their UTRs, sRNAs and tRNA precursors),
    // cut from the INSDC genome RegulonDB annotates
    regulondb {
      run = false
      graphql = 'https://regulondb.ccg.unam.mx/graphql'
      genome = 'https://www.ebi.ac.uk/ena/browser/api/embl/U00096.3?download=true'
    }

    ribovision {
      r2dt_repo = "https://github.com/RNAcentral/R2DT.git"
    }

    ribocentre {
      remote = 'https://github.com/aoying35/Ribocentre-data/raw/refs/heads/main/ribocentre.json'
    }

    rfam {
     remote = '/hps/nobackup/production/xfam/rfam/RELEASES/14.1/rnacentral/json_files/rfam2rnac*.json'
    }

    rgd {
      sequences = 'https://download.rgd.mcw.edu/pub/data_release/UserReqFiles/RAT_NUCLEOTIDE_SEQUENCES.fa.gz'
      genes = 'https://download.rgd.mcw.edu/pub/data_release/GENES_RAT.txt'
    }

    sgd {
      remote = "https://downloads.yeastgenome.org/latest/RNAcentral.json"
    }

    // mRNAs and their UTRs, separate from the ncRNA import above
    sgd_coding {
      run = false
      remote = "https://downloads.yeastgenome.org/curation/chromosomal_feature/saccharomyces_cerevisiae.gff.gz"
    }

    // mRNAs and UTRs of probed organisms: the ENA records their probing data is mapped to.
    // Taxids are those in rnacentral-probing-metadata, which match what RNAcentral already holds.
    ena_coding {
      run = false
      url = 'https://www.ebi.ac.uk/ena/browser/api/embl'
      sources = [
        [name: 'kluyveromyces_lactis', taxid: 28985, assembly: 'ASM251v1', accessions: 'CR382121.1,CR382122.1,CR382123.1,CR382124.1,CR382125.1,CR382126.1'],
        [name: 'debaryomyces_hansenii', taxid: 284592, assembly: 'ASM644v2', accessions: 'CR382133.2,CR382134.2,CR382135.2,CR382136.2,CR382137.2,CR382138.2,CR382139.2'],
        [name: 'pseudomonas_savastanoi', taxid: 264730, assembly: 'ASM1220v1', accessions: 'CP000058.1,CP000059.1,CP000060.1'],
        [name: 'dengue_virus_1', taxid: 11053, accessions: 'AY145121.1,EU081230.1'],
        [name: 'dengue_virus_2', taxid: 11060, accessions: 'EU081177.1,U87411.1'],
        [name: 'dengue_virus_3', taxid: 11069, accessions: 'EU081190.1'],
        [name: 'dengue_virus_4', taxid: 11070, accessions: 'GQ398256.1,KR011349.2,KU513442.1'],
        // AF324493.2 is the whole pNL4-3 plasmid: keep the provirus (1-9709, 5' to 3' LTR), the span its probing data is mapped to
        [name: 'hiv', taxid: 11676, accessions: 'AF324493.2', end: 9709],
        [name: 'human_bocavirus', taxid: 3052040, accessions: 'JQ923422.1'],
        [name: 'influenza_a_virus', taxid: 11320, accessions: 'CY034132.1,CY034133.1,CY034134.1,CY034135.1,CY034136.1,CY034137.1,CY034138.1,CY034139.1,V01099.1,V01088.1,J02146.1,J02147.1,J02150.1,J02151.1,V01106.1,V00603.1'],
        [name: 'murine_norovirus', taxid: 223997, accessions: 'EF014462.1'],
        [name: 'porcine_epidemic_diarrhea_virus', taxid: 28295, accessions: 'MK584552.1'],
        [name: 'rotavirus_a', taxid: 28875, accessions: 'KF729687.1,KF729688.1,KF729689.1,KF729690.1,KF729691.1,KF729692.1,KF729693.1,KF729694.1,KF729695.1,KF729696.1,KF729697.1'],
        [name: 'sars_cov_2', taxid: 2697049, accessions: 'MN908947.3,MT510999.1,MT576563.1'],
        [name: 'west_nile_virus', taxid: 11082, accessions: 'AF404756.1'],
        [name: 'yellow_fever_virus', taxid: 11089, accessions: 'AY640589.1,MN106242.1,PX660172.1'],
        [name: 'zika_virus', taxid: 64320, accessions: 'AY632535.2,KJ776791.2,KU365780.1'],
      ]
    }

    tmrna {
      data = '/nfs/production/agb/rnacentral/provided-data/tmrna/tmrna.tsv'
    }

    tarbase {
      remotes = [
        'https://dianalab.e-ce.uth.gr/tarbasev9/data/Homo_sapiens_TarBase-v9.tsv.gz',
        'https://dianalab.e-ce.uth.gr/tarbasev9/data/Mus_musculus_TarBase-v9.tsv.gz',
        'https://dianalab.e-ce.uth.gr/tarbasev9/data/Viral_species_TarBase-v9.tsv.gz',
        'https://dianalab.e-ce.uth.gr/tarbasev9/data/Other_species_TarBase-v9.tsv.gz'
      ]
    }

    zfin {
      run = false
      remote = 'https://zfin.org/downloads/rnaCentral.json'
    }

    zwd {
      needs_taxonomy = true
      remote = 'https://raw.githubusercontent.com/Rfam/rfam-zwd-import/master/zwd.json'
    }
  }
}
