params {
  genome_mapping {
    run = true
    min_length = 20
    max_length = 100000

    fetch_unmapped_sequences {
      directives.maxForks = 20
      nucleotides_per_chunk = '2e6'
      sequences_per_chunk = 20000
    }

    download_genome {
      directives.memory = 8.GB
    }

    select_mapped {
      directives.memory = 5.GB
    }

    blat {
      options {
        step_size = 5
        rep_match = 2253
        min_score = 0
        min_identity = 95
      }
      directives.memory = 10.GB
    }

    species_excluded_from_mapping = [
      'anas_platyrhynchos',     // Cannot find genome
      'brassica_rapa',          // Cannot find genome
      'aegilops_tauschii',      // Cannot find genome
      'theobroma_cacao',        // Hard to download
      'pristionchus_pacificus', // Hard to download

      // Genomes above blat's 4.29Gb (2^32) ceiling. Target coordinates are
      // 32-bit, so clumpHits aborts on an assertion before aligning anything.
      //TODO: The fix is to shard each target to under 4Gb and concatenate the psl.
      //Recording which species are affected:
      'triticum_aestivum_alchemy',    // 15.4Gb, 188 chunks dropped
      'triticum_aestivum_arinalrfor', // 14.7Gb, 188 chunks dropped
      'triticum_spelta',              // 14.0Gb
      'vicia_faba',                   // 11.9Gb
      'avena_sativa_ot3098',          // 10.8Gb
      'triticum_turgidum',            // 10.5Gb
      'triticum_dicoccoides',         // 10.1Gb
      'triticum_timopheevii',         //  9.4Gb
      'schistocerca_serialis_gca023864345v3rs',   // 9.1Gb
      'schistocerca_americana_gca021461395v2rs',  // 9.0Gb
      'schistocerca_nitens_gca023898315v2rs',     // 8.8Gb
      'schistocerca_gregaria_gca023897955v2rs',   // 8.7Gb
      'schistocerca_piceifrons_gca021461385v2rs', // 8.7Gb
      'schistocerca_cancellata_gca023864275v2rs', // 8.5Gb
      'secale_cereale',               //  6.8Gb
      'lathyrus_sativus',             //  6.0Gb
      'triticum_urartu',              //  4.9Gb
      'ochotona_princeps',            //  4.8Gb
      'hordeum_vulgare_ft11',         //  4.3Gb
    ]

  }
}
