manifest {
  mainScript = 'main.nf'
  description = 'Import all RNAcentral data'
  nextflowVersion = '>=26.04.0'
}

report {
  overwrite = true
}

includeConfig "config/main.config"
includeConfig "config/export.config"
includeConfig "config/crs.config"

// Interchange format produced by parsers and consumed by the load step.
// 'csv' is the historical pgloader path; 'parquet' routes through DuckDB
// via bin/load-parquet. Flip in local.config or on the CLI.
params.writer_format = 'csv'

process {
  container = 'oras://ghcr.io/rnacentral/rnacentral-import-pipeline:latest'
}

// local.config must should contain something like the following. I use profiles
// to help control the database I am working with:
// env {
//   PGDATABASE = "postgres://user:password@host:port/name"
// }
includeConfig "local.config"

// Propagate the format choice to every parser subprocess. Read inside
// rnacentral_pipeline.writers.entry_writer().
//
// This MUST be the top-level `env` scope, not a `process { env = [...] }`
// directive: `env` is only an input/output qualifier, so as a directive it is
// silently ignored and every parser falls back to the csv default. It also
// must stay below the local.config include, since the value is read here.
env {
  RNAC_OUTPUT_FORMAT = params.writer_format

  // The load processes run with `--contain`, so $HOME is isolated and DuckDB
  // has nowhere to cache the postgres extension. Point it at a bind-mounted
  // directory shared by every task, so the extension is fetched once.
  DUCKDB_HOME = "$baseDir/work/duckdb"
}

// needs_publications / should_release / needs_taxonomy are deliberately absent:
// a value here wins over the script assignment that derives them, so defaulting
// them here left them permanently false. Use skip_release to opt out.
params {
  skip_publications = false
  skip_release = false
  qc = [publish_dir: 'qc-reports']
}
